{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecodrive",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecodrive-db",
      "database_id": "1d62860c-443f-4e4f-b147-9c2350d3cb84",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ecodrive-preview-db",
        "database_id": "a7351f8e-0ece-486e-8533-c3e987b6291c",
        "migrations_dir": "migrations"
      }
    ]
  }
}
